# Copy to .env (same folder) for local dev. .env is gitignored - never commit it.
# On Render, set these as real environment variables in the service dashboard
# instead (render.yaml references them with sync: false so it won't prompt
# you to commit values).

# Random long string - signs the Flask session cookie.
FLASK_SECRET_KEY=change-me-to-something-random

# Password for the dashboard/card manager login (docs/site-project-plan.md
# section 5). Separate from DEVICE_API_KEY below on purpose.
SITE_PASSWORD=change-me

# Must match REMOTE_API_KEY in firmware/DeskMate/RemoteApi.h exactly -
# this is what the device sends as X-Device-Key.
DEVICE_API_KEY=change-me-too
